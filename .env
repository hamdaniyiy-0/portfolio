# ============================================================
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env (berisi App Password Gmail).
# ============================================================

# Port server API/Express (frontend Vite memanggil /api lewat proxy)
PORT=8787

# ============================================================
# SMTP Gmail
# ============================================================
# Host & port resmi Gmail:
#   - port 465 + SMTP_SECURE=true  (SSL, direkomendasikan)
#   - port 587 + SMTP_SECURE=false (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Akun Gmail pengirim (juga dipakai sebagai user SMTP)
SMTP_USER=hamdanif042@gmail.com

# App Password 16 karakter dari Google (BUKAN password akun Gmail).
# Cara membuat: https://myaccount.google.com/apppasswords
# (Aktifkan 2-Step Verification terlebih dahulu.)
SMTP_PASS=aymaycolepfjrdku

# Alamat email tujuan (boleh sama dengan SMTP_USER)
EMAIL_TO=hamdanif042@gmail.com

# ============================================================
# Opsional: kalau API tidak satu domain dengan frontend,
# set URL penuh di file .env frontend (prefix VITE_):
# VITE_API_URL=https://api.domainkamu.com/api/contact
# ============================================================
